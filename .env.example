# Firebase web app config (Firebase console > Project settings > Your apps > Web app > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud model used for the writing step (Gemini Developer API via Firebase AI Logic)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# App Check (reCAPTCHA Enterprise). Optional until you enforce App Check on Firebase AI Logic.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local testing with enforcement on: set to true, open the app, copy the debug token from the
# browser console into Firebase console > App Check > Manage debug tokens. Or paste a registered token.
VITE_APPCHECK_DEBUG_TOKEN=
