# Firebase web app config (Firebase console > Project settings > Your apps > Web app > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud model used for the writing step (Gemini Developer API via Firebase AI Logic)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# App Check (reCAPTCHA Enterprise). Optional until you enforce App Check on Firebase AI Logic.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Or a free reCAPTCHA v3 site key (register it in Firebase console > App Check with its secret key).
VITE_RECAPTCHA_V3_SITE_KEY=
# For local testing with enforcement on: paste a debug token registered in Firebase console >
# App Check > Apps > (your web app) > Manage debug tokens. A debug token alone is enough locally;
# no site key is needed. Or set to true and copy the token the SDK prints in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=
